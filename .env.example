# Copy to .env.local for local `node serve.mjs` (never commit .env.local).
# Vercel: Settings → Environment Variables (redeploy after saving)
#
# CAPABILITIES_ADMIN_SECRET — password for /capabilities/admin
# CAPABILITIES_SESSION_SECRET — random string for login cookies
# SOUND_DECK_SHARE_TOKEN — unguessable token for email share links (see /sound-deck/?access=...)
#
# Home order (Edge Config — workOrder ~7KB; writes need VERCEL_API_TOKEN + EDGE_CONFIG_ID):
# VERCEL_DEPLOY_HOOK_URL=   (preferred for admin publish — not counted against API deploy quota)
# VERCEL_REDEPLOY_COOLDOWN_MS=600000  (optional, default 10 min between admin-triggered redeploys)
# VERCEL_API_TOKEN=
# EDGE_CONFIG_ID=
# EDGE_CONFIG_READ_TOKEN=
# VERCEL_TEAM_ID=  (optional, if project is under a team)
#
# Work CMS catalog (~22KB; too large for Hobby Edge Config — requires Upstash Redis on Vercel):
# UPSTASH_REDIS_REST_URL=          (from Upstash dashboard → REST API)
# UPSTASH_REDIS_REST_TOKEN=
# Or reuse capabilities KV aliases: CAPABILITIES_UPSTASH_URL / CAPABILITIES_UPSTASH_TOKEN
# Or Vercel KV integration: KV_REST_API_URL / KV_REST_API_TOKEN
#
# Easiest allowlist (comma or newline separated emails):
# CAPABILITIES_ALLOWED_EMAILS=client@agency.com, partner@brand.com
#
# Or edit data/deck-allowlist.txt (one email per line) and push to GitHub.
CAPABILITIES_ADMIN_SECRET=
CAPABILITIES_SESSION_SECRET=
SOUND_DECK_SHARE_TOKEN=
CAPABILITIES_ALLOWED_EMAILS=
