{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/capabilities/login",
      "destination": "/capabilities/login.html"
    },
    {
      "source": "/capabilities/login/",
      "destination": "/capabilities/login.html"
    },
    {
      "source": "/capabilities/admin",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/capabilities/admin/",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/capabilities",
      "destination": "/capabilities/index.html"
    },
    {
      "source": "/capabilities/",
      "destination": "/capabilities/index.html"
    }
  ]
}
