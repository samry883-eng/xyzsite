{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/capabilities",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/capabilities/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/capabilities/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/projects",
      "destination": "/projects/index.html"
    },
    {
      "source": "/projects/",
      "destination": "/projects/index.html"
    },
    {
      "source": "/work",
      "destination": "/work/index.html"
    },
    {
      "source": "/work/",
      "destination": "/work/index.html"
    },
    {
      "source": "/capabilities/login",
      "destination": "/capabilities/login.html"
    },
    {
      "source": "/capabilities/login/",
      "destination": "/capabilities/login.html"
    },
    {
      "source": "/capabilities/admin",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/capabilities/admin/",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/admin",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/capabilities/admin.html"
    },
    {
      "source": "/capabilities/vfx",
      "destination": "/capabilities/vfx/index.html"
    },
    {
      "source": "/capabilities/vfx/",
      "destination": "/capabilities/vfx/index.html"
    },
    {
      "source": "/capabilities/sound",
      "destination": "/capabilities/sound/index.html"
    },
    {
      "source": "/capabilities/sound/",
      "destination": "/capabilities/sound/index.html"
    },
    {
      "source": "/capabilities",
      "destination": "/capabilities/index.html"
    },
    {
      "source": "/capabilities/",
      "destination": "/capabilities/index.html"
    }
  ]
}
